# Pooled Neon connection. The app uses this at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/teamflow?sslmode=require"

# Direct Neon connection. Prisma Migrate uses this. Do not use the pooler here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/teamflow?sslmode=require"

# Shared password for seeded local users only. Never use this value in production.
SEED_PASSWORD="Password123!"

# Auth.js. Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Used from Day 7 onward. The key and cluster are safe in the browser. The secret and app id stay on the server.
# PUSHER_APP_ID=""
# NEXT_PUBLIC_PUSHER_KEY=""
# PUSHER_SECRET=""
# PUSHER_CLUSTER=""
# NEXT_PUBLIC_PUSHER_CLUSTER=""

# Private R2 bucket (S3 API) for avatars and project files. Leave blank to skip uploads locally.
# CORS must allow PUT from your app origin (e.g. http://localhost:3000) with Content-Type.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# Invitation, password-reset, and task-assignment email. Without these, local development prints a note instead of sending it.
RESEND_API_KEY=""
EMAIL_FROM="Teamflow <noreply@your-domain.com>"

# Optional. Used only to download Google Stitch design HTML/screenshots into designs/stitch/.
# STITCH_API_KEY=""
