# Pooled Neon connection. The app uses this at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/teamflow?sslmode=require"

# Direct Neon connection. Prisma Migrate uses this. Do not use the pooler here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/teamflow?sslmode=require"

# Shared password for seeded local users only. Never use this value in production.
SEED_PASSWORD="Password123!"

# Used from Day 2 onward.
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# Used from Day 7 onward. Only the key is public.
# PUSHER_APP_ID=""
# NEXT_PUBLIC_PUSHER_KEY=""
# PUSHER_SECRET=""
# PUSHER_CLUSTER=""

# Used from Day 4 onward. Keep the bucket private.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# Used from Day 3 onward.
# RESEND_API_KEY=""
# EMAIL_FROM="Teamflow <noreply@your-domain.com>"
